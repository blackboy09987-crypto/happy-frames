# ---- Happy Frames environment variables ----
# In milne wale keys ko Vercel > Project > Settings > Environment Variables mein daalein.
# Local test ke liye is file ko copy karke ".env.local" bana lein aur values bhar dein.

# Supabase project ke Settings > API se:
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Admin panel (/admin) ka password — jo chahein rakhein:
ADMIN_PASSWORD=change-this-password

# Supabase Storage bucket ka naam (public bucket banayein isi naam se):
SUPABASE_BUCKET=product-images
